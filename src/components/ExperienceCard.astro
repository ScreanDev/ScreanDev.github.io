---
// src/components/DegreeCard.astro

interface Props {
  t: any;
  title: string;
  subtitle: string;
  details: string[];
  skills: string[];
  img: { src: string };
  imgAlt: string;
}

const { title, subtitle, details, skills, img, imgAlt } = Astro.props as Props;
const { t } = Astro.props;
---



<div class="timeline-item">
    <div class="content-block">
        <img src={img.src} alt={imgAlt}>
        <div class="timeline-degree-info">
            <h3>{title}</h3>
            <p><b>{subtitle}</b></p>
            <ul>
                {details.map((detail) => <li>• {detail}</li>)}
            </ul>
                        
            <hr class="center-aligned" style="width: 100%;">
            <p><b>{t.experience.skillsDeveloped}</b></p>
            <ul>
                {skills.map((skill) => <li>• {skill}</li>)}
            </ul>
        </div>
    </div>
<!-- Dernier bloc sans flèche -->
</div>