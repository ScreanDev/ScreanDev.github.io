---
import BaseLayout from '../layouts/main-page/BaseLayout.astro';
import Separator from '../layouts/main-page/Separator.astro';
import Navbar from '../layouts/main-page/Navbar.astro';
import Introducing from '../layouts/main-page/Introducing.astro';
import Degree from '../layouts/main-page/Degree.astro';
import Experience from '../layouts/main-page/Experience.astro';
import Skills from '../layouts/main-page/Skill.astro';
import Project from '../layouts/main-page/Project.astro';
import Contact from '../layouts/main-page/Contact.astro';
---

<BaseLayout titre="Pausé-Chapuis Lucas | Portfolio">
  <header>
    <Navbar />
    <button onclick="window.location.href='/test'">Aller à la page de test</button>
  </header>

  <main>
    <Introducing />

    <Separator />

    <div id="degree" class="degree-section">
      <section class="degree-separator">
        <Degree />
      </section>
      <section class="degree-separator">
        <Experience />
      </section>
    </div>

    <Separator />
    
    <Skills />

    <Project />

    <Separator />

    <Contact />
  </main>
  
  <footer>
    <p>© 2026 - Fait avec &#x2661 avec Astro</p>
  </footer>
</BaseLayout>