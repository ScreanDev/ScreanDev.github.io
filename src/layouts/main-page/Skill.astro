---
import SkillCard from "../../components/SkillCard.astro"
import '../../styles/components/skill.scss';

const { t } = Astro.props;
---

<div id="skills" class="skills-section">
    <section class="title-block">
        <h2>{t.skills.title}</h2>
        <h3></h3>
    </section>

    <div class="skills-container">
        <SkillCard 
            skill={t.skills.cardHardSkills.title}
            skillIcon="fa-power-off" 
            list={[
                t.skills.cardHardSkills.s1,
                t.skills.cardHardSkills.s2,
                t.skills.cardHardSkills.s3,
                t.skills.cardHardSkills.s4,
                t.skills.cardHardSkills.s5,
                t.skills.cardHardSkills.s6,
                t.skills.cardHardSkills.s7
            ]}
        />

        <SkillCard 
            skill={t.skills.cardSoftSkills.title}
            skillIcon="fa-certificate" 
            list={[
                t.skills.cardSoftSkills.s1,
                t.skills.cardSoftSkills.s2,
                t.skills.cardSoftSkills.s3,
                t.skills.cardSoftSkills.s4,
                t.skills.cardSoftSkills.s5,
                t.skills.cardSoftSkills.s6,
                t.skills.cardSoftSkills.s7
            ]}
        />

        <SkillCard 
            skill={t.skills.cardLanguages.title} 
            skillIcon="fa-language" 
            list={[
                t.skills.cardLanguages.s1,
                t.skills.cardLanguages.s2,
                t.skills.cardLanguages.s3
            ]}
        />
        
        <SkillCard 
            skill={t.skills.cardHobbies.title}
            skillIcon="fa-hourglass" 
            list={[
                t.skills.cardHobbies.s1,
                t.skills.cardHobbies.s2,
                t.skills.cardHobbies.s3,
                t.skills.cardHobbies.s4,
                t.skills.cardHobbies.s5,
                t.skills.cardHobbies.s6
            ]}
        />
    </div>
</div>