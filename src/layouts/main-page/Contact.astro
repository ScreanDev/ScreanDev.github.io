---
import '../../styles/components/contact.scss';
import '../../styles/titles.scss';
---

<section id="contact" class="contact-section">
    <div class="container right-container">
        <section class="title-block">
            <h2>Gardons contact</h2>
            <h3></h3>
        <p>Vous souhaitez me contacter ? Voici mes informations !</p>
        </section>
    </div>
    <div class="contact-container">
        <div class="contact-block" onclick="copyToClipboard(this)">
            <i class="fa-solid fa-phone"></i>
            <h3>Téléphone</h3>
            <p>07 64 20 49 26</p>
        </div>
        <div class="contact-block" onclick="copyToClipboard(this)">
            <i class="fa-solid fa-envelope"></i>
            <h3>Email universitaire</h3>
            <p><a href="mailto:lucas.pause-chapuis@universite-paris-saclay.fr">lucas.pause-chapuis@universite-paris-saclay.fr</a></p>
        </div>
        <div class="contact-block">
            <a href="https://github.com/ScreanDev" target="_blank">
            <i class="fa-brands fa-github"></i>
            <h3>GitHub</h3>
            <p>Voir mon profil</p>
            </a>
        </div>
        <div class="contact-block">
            <a href="https://www.linkedin.com/in/lucas-pausé-chapuis-3a438432b/" target="_blank">
            <i class="fa-brands fa-linkedin"></i>
            <h3>LinkedIn</h3>
            <p>Voir mon profil</p>
            </a>
        </div>
    </div>
</section>