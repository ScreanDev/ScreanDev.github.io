---
import '../../styles/components/contact.scss';
import '../../styles/titles.scss';

const { t } = Astro.props;
---

<section id="contact" class="contact-section">
    <div class="container right-container">
        <section class="title-block">
            <h2>{t.contact.header}</h2>
            <h3></h3>
            <p>{t.contact.subtitle}</p>
        </section>
    </div>
    <div class="contact-container">
        <div class="contact-block js-copy">
            <i class="fa-solid fa-phone"></i>
            <h3>{t.contact.info.phone.title}</h3>
            <p>{t.contact.info.phone.value}</p>
        </div>
        <div class="contact-block js-link" data-url="mailto:lucas.pause-chapuis@universite-paris-saclay.fr">
            <i class="fa-solid fa-envelope"></i>
            <h3>{t.contact.info.email.title}</h3>
            <p><a href="mailto:lucas.pause-chapuis@universite-paris-saclay.fr">{t.contact.info.email.value}</a></p>
        </div>
        <div class="contact-block js-link" data-url="https://github.com/ScreanDev">
            <i class="fa-brands fa-github"></i>
            <h3>{t.contact.info.github.title}</h3>
            <p>{t.contact.info.github.value}</p>
            </a>
        </div>
        <div class="contact-block js-link" data-url="https://www.linkedin.com/in/lucas-pausé-chapuis-3a438432b/">
            <i class="fa-brands fa-linkedin"></i>
            <h3>{t.contact.info.linkedin.title}</h3>
            <p>{t.contact.info.linkedin.value}</p>
            </a>
        </div>

        <div id="copy-notification">{t.utils.copyToClipboard}</div>
    </div>
</section>

<script>
    // Copy info to clipboard
    const copyBlocks = document.querySelectorAll('.js-copy');
    const popUp = document.getElementById("copy-notification");

    copyBlocks.forEach(block => {
        block.addEventListener('click', () => {
            const textToCopy = block.querySelector("p")?.innerText;

            navigator.clipboard.writeText(textToCopy as string)
                .then(() => {
                    if (popUp) {
                        popUp.classList.add("show");
                        setTimeout(() => {
                            popUp.classList.remove("show");
                        }, 2000); // Disappear after 2 seconds
                    }
                })
                .catch(err => {
                    console.error("Erreur lors de la copie :", err);
                });
        });
    });

    // Open links in new tab
    const linkBlocks = document.querySelectorAll('.js-link');

    linkBlocks.forEach(block => {
        block.addEventListener('click', () => {
            const url = block.getAttribute('data-url');
            if (url) {
                window.open(url, '_blank');
            }
        });
    });
</script>