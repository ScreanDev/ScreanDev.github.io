---
    
    <hr class="animated-hr center-aligned" style="width: 90%;">

    <div id="projects" class="container left-container">
        <section class="title-block">
            <h2>Mes projets</h2>
            <h3></h3>
            <p>Vous trouverez ici quelques-uns des projets sur lesquels j'ai travaillé.</p>
        </section>
    </div>

<section class="project-section">
    <h3 class="project-container-title"><i class="fa-solid fa-code"></i> Projets informatiques</h3>
    <div class="project-container">

        {projectMdFiles.map((projet) => {
            const bannerPath = `../../assets/${projet.frontmatter.banner}`;
            const modalBannerPath = `../../assets/${projet.frontmatter.modalBanner}`;

            const bannerModule = images[bannerPath];
            const modalBannerModule = images[modalBannerPath];

            // On vérifie que les modules ont bien été trouvés AVANT de créer la carte.
            if (!bannerModule || !modalBannerModule) {
                console.log(`\n🚨 ALERTE SUR LE PROJET : ${projet.frontmatter.title}`);
                console.log(`On a cherché ce chemin : ${bannerPath}`); 
                console.log(`Est-ce qu'il existe dans nos assets ? -> NON`);
                return null;
            }

            // La carte n'est retournée QUE si JavaScript a pu calculer toutes ses props.
            // S'il y a un plantage, il aura lieu après les console.log mais avant le rendu.
            return (
                <ProjectCard
                    title={projet.frontmatter.title}
                    tags={projet.frontmatter.tags}
                    description={projet.frontmatter.description}
                    banner={bannerModule.default.src}
                    modalDesc={projet.frontmatter.modalDesc}
                    modalBanner={modalBannerModule.default.src}
                >
                    <projet.Content />
                </ProjectCard>
            );
        })}


        
    </div>
</section>