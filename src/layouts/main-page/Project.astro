---
import '../../styles/components/project.scss';
import ProjectCard from '../../components/ProjectCard.astro';

const images = import.meta.glob<{ default: { src: string } }>('../../assets/*.{png,jpg,jpeg,gif}', { eager: true });

console.log(Object.keys(images));

const { t } = Astro.props;

const itProjectMdFilesByLang = {
    fr: await Astro.glob('./project-md/it/fr/*.md'),
    en: await Astro.glob('./project-md/it/en/*.md')
};

const otherProjectMdFilesByLang = {
    fr: await Astro.glob('./project-md/other/fr/*.md'),
    en: await Astro.glob('./project-md/other/en/*.md')
};

const lang = t.lang === 'en' ? 'en' : 'fr';
const itProjectMdFiles = itProjectMdFilesByLang[lang];
const otherProjectMdFiles = otherProjectMdFilesByLang[lang];

const projectSections = [
    {
        title: "Projets informatiques",
        icon: "fa-code",
        files: itProjectMdFiles
    },
    {
        title: "Autres projets",
        icon: "fa-palette",
        files: otherProjectMdFiles
    }
];


---
    
    <hr class="animated-hr center-aligned" style="width: 90%;">

    <div id="projects" class="container left-container">
        <section class="title-block">
            <h2>Mes projets</h2>
            <h3></h3>
            <p>Vous trouverez ici quelques-uns des projets sur lesquels j'ai travaillé.</p>
        </section>
    </div>

<section class="project-section">
    {projectSections.map((section) => (
        <> <h3 class="project-container-title">
                <i class={`fa-solid ${section.icon}`}></i> {section.title}
            </h3>
            
            <div class="project-container">
                {section.files.map((projet: any) => {
                    const bannerPath = `../../assets/${projet.frontmatter.banner}`;
                    const modalBannerPath = `../../assets/${projet.frontmatter.modalBanner}`;

                    const bannerModule = images[bannerPath];
                    const modalBannerModule = images[modalBannerPath];

                    if (!bannerModule || !modalBannerModule) {
                        console.log(`\n🚨 UNABLE TO CREATE CARD FOR PROJECT: ${projet.frontmatter.title}`);
                        if (!bannerModule) console.log(`Could not find asset: ${bannerPath}`);
                        if (!modalBannerModule) console.log(`Could not find asset: ${modalBannerPath}`);
                        return null;
                    }

                    return (
                        <ProjectCard
                            title={projet.frontmatter.title}
                            tags={projet.frontmatter.tags}
                            description={projet.frontmatter.description}
                            banner={bannerModule.default.src}
                            modalDesc={projet.frontmatter.modalDesc}
                            modalBanner={modalBannerModule.default.src}
                        >
                            <projet.Content />
                        </ProjectCard>
                    );
                })}
            </div>

        </>
    ))}
    </div>
</section>