---
import '../../styles/components/containers.scss';
import '../../styles/components/education.scss';
import ExperienceCard from '../../components/ExperienceCard.astro';

import razelBecImg from '../../assets/logo-razel-bec.jpg';
import unightImg from '../../assets/projet-frosthorn.png';

const { t } = Astro.props;
---


<section class="title-block">
    <h2>{t.experience.title}</h2>
    <h3></h3>
</section>

<section class="timeline-section">
    <div class="timeline">
        <ExperienceCard 
            t={t}
            title={t.experience.razelBec.title} 
            subtitle={t.experience.razelBec.subtitle} 
            details={[
                t.experience.razelBec.details.d1,
                t.experience.razelBec.details.d2,
                t.experience.razelBec.details.d3,
                t.experience.razelBec.details.d4
            ]}
            skills={[
                t.experience.razelBec.skills.s1,
                t.experience.razelBec.skills.s2,
                t.experience.razelBec.skills.s3,
                t.experience.razelBec.skills.s4,
                t.experience.razelBec.skills.s5
            ]}
            img={razelBecImg}
            imgAlt="Razel-Bec Icon"
        />
    </div>
</section>
