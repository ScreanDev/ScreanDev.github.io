---
import '../../styles/components/containers.scss';
import '../../styles/components/education.scss';
import ExperienceCard from '../../components/ExperienceCard.astro';

import razelBecImg from '../../assets/logo-razel-bec.jpg';
import unightImg from '../../assets/projet-frosthorn.png';
---


<section class="title-block">
    <h2>Expériences professionnelles</h2>
    <h3></h3>
</section>

<section class="timeline-section">
    <div class="timeline">
        <ExperienceCard 
            title="Stage d'observation chez Razel-Bec" 
            subtitle="Razel-Bec | Groupe Fayat – 2021" 
            details={[
                "Secteur informatique",
                "Génie civil",
                "Laboratoire",
                "Coordination d'équipe"
            ]}
            skills={[
                "Premier aperçu du monde professionnel",
                "Observation des métiers de l'informatique et du génie civil",
                "Cohésion entre les nombreux secteurs d'une entreprise",
                "Apprentissage de la coordination d'équipe",
                "Contribution à la configuration ou à la réparation d'appareils informatiques"
            ]}
            img={razelBecImg}
            imgAlt="Logo Razel-Bec"
        />
    </div>
</section>
