---
import '../../styles/components/containers.scss';
import '../../styles/components/education.scss';
import EducationCard from '../../components/DegreeCard.astro';

import butInfoImg from '../../assets/universite.jpg';
import lyceeImg from '../../assets/highschool-banner.png';
import collegeImg from '../../assets/logo-college.jpg';

const { t } = Astro.props;
---

<section class="title-block">
    <h2>{t.degree.title}</h2>
    <h3></h3>
</section>

<section class="timeline-section">
    <div class="timeline">

        <EducationCard 
            degree={t.degree.bachelorCard.degree} 
            education={t.degree.bachelorCard.education} 
            description={t.degree.bachelorCard.description}
            img={butInfoImg.src}
            imgAlt="Orsay University Institute of Technology picture"
            endArrow={false}
        />

        <EducationCard 
            degree={t.degree.highschoolCard.degree} 
            education={t.degree.highschoolCard.education} 
            description={t.degree.highschoolCard.description}
            img={lyceeImg.src}
            imgAlt="Marguerite Yourcenar high school picture"
            endArrow={true}
        />

    </div>
</section>