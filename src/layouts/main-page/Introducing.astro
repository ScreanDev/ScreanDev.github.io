---
import '../../styles/components/big-title.scss';
import '../../styles/components/containers.scss';

import scratchFrame from '../../assets/scratch-frame.png';

const { t } = Astro.props;
---

<section class="main-big-title-section">
    <div class="main-big-title-section-inner">
        <h1 id="main-big-title" set:html={t.introducing.mainBigTitle}></h1>
    </div>
</section>

<div class="container center-container">
    <section class="section-block" style="width: 70%;">
        <h2>{t.introducing.contentBlockHeader}</h2>
        <h3>{t.introducing.contentBlockSubheader}</h3>
        <p set:html={t.introducing.contentBlockParagraph1}></p>
        <p set:html={t.introducing.contentBlockParagraph2}></p>
        <p set:html={t.introducing.contentBlockParagraph3}></p>
        <p set:html={t.introducing.contentBlockParagraph4}></p>
    </section>
</div>

<div class="container right-container">
    <section class="section-block">
        <h2>{t.introducing.scratchFrameHeader}</h2>
        <h3></h3>
        <p set:html={t.introducing.scratchFrameParagraph1}></p>
        <p set:html={t.introducing.scratchFrameParagraph2}></p>
    </section>

    <section>
        <img src={scratchFrame.src} alt="Scratch Image" width="600">
    </section>
</div>