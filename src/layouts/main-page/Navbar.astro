---
import '../../styles/components/navbar.scss';

const { t } = Astro.props;
---

<div class="header">
    <div class="burger" onclick="document.querySelector('.inner-header').classList.toggle('active')">
        <i class="fa-solid fa-bars"></i>
    </div>

    <div class="inner-header">
        <h2 set:html={t.nav.degree}></h2>
        <h2 set:html={t.nav.skills}></h2>
        <h2 set:html={t.hero.projects}></h2>
        <h2 set:html={t.hero.contact}></h2>
    </div>
</div>